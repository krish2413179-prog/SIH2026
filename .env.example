# ─────────────────────────────────────────────
#  Application
# ─────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_SECRET_KEY=change-me-to-a-32-byte-secret
DEBUG=true

# ─────────────────────────────────────────────
#  Database
# ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vasp_engine
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vasp_engine

# Column-level encryption key (32-byte hex string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DB_ENCRYPTION_KEY=change-me-to-a-64-hex-char-string-32bytes

# ─────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─────────────────────────────────────────────
#  JWT
# ─────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_KEY_ROTATION_DAYS=90

# ─────────────────────────────────────────────
#  Blockchain API Keys
# ─────────────────────────────────────────────
ETHERSCAN_API_KEY=your-etherscan-api-key
BSCSCAN_API_KEY=your-bscscan-api-key
POLYGONSCAN_API_KEY=your-polygonscan-api-key
SOLSCAN_API_KEY=your-solscan-api-key

# ─────────────────────────────────────────────
#  Blockchain Cache TTL (seconds)
# ─────────────────────────────────────────────
BLOCKCHAIN_CACHE_TTL=1800

# ─────────────────────────────────────────────
#  Object Storage (S3-compatible / MinIO)
# ─────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=vasp-engine-reports
S3_REGION=us-east-1

# ─────────────────────────────────────────────
#  SAHYOG Portal
# ─────────────────────────────────────────────
SAHYOG_ENDPOINT_URL=https://sahyog.gov.in/api
SAHYOG_AUTH_TYPE=api_key
SAHYOG_API_KEY=your-sahyog-api-key

# ─────────────────────────────────────────────
#  Audit Log
# ─────────────────────────────────────────────
# Maximum audit log size in bytes (alert at 80%)
AUDIT_MAX_SIZE_BYTES=10737418240    # 10 GB

# ─────────────────────────────────────────────
#  Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─────────────────────────────────────────────
#  Queue
# ─────────────────────────────────────────────
TRACE_QUEUE_DEPTH_LIMIT=100

# ─────────────────────────────────────────────
#  CORS (comma-separated origins)
# ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ─────────────────────────────────────────────
#  Gemini LLM (wallet suspicion analysis)
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
